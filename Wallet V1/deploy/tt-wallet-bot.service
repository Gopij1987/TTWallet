[Unit]
Description=TT Wallet V1 Telegram Bot Trigger
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tt-wallet/Wallet V1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 "/home/ubuntu/tt-wallet/Wallet V1/telegram_bot.py"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
